{
  "manifest_version": 3,
  "name": "fixture bad background",
  "version": "0.0.1",
  "permissions": ["storage"],
  "host_permissions": ["*://www.youtube.com/*"],
  "content_scripts": [
    { "matches": ["*://www.youtube.com/*"], "js": ["app/content.js"] }
  ],
  "action": { "default_popup": "app/popup.html" },
  "background": { "service_worker": "app/content.js" }
}
