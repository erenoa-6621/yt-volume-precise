{
  "manifest_version": 3,
  "name": "YT Volume Precise",
  "version": "0.1.0",
  "description": "YouTube の音量を数値入力とプリセットで正確に操作します。要求する権限は保存領域と YouTube のみです。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "src/lib/volume.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "css": [
        "src/overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page.js"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "*://music.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "YT Volume Precise"
  }
}
