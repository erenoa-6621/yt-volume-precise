{
  "manifest_version": 3,
  "name": "fixture good",
  "version": "0.0.1",
  "permissions": ["storage"],
  "host_permissions": ["*://www.youtube.com/*", "*://music.youtube.com/*"],
  "content_scripts": [
    { "matches": ["*://www.youtube.com/*"], "js": ["app/content.js"], "css": ["app/overlay.css"] }
  ],
  "action": { "default_popup": "app/popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
